///|
/// Generation of the Host entry adapter packages under the module source
/// root's `passport-generated/` tree: CLI-owned build output, wiped and
/// recreated by every build. The project's own source files are never written.

///|
/// Removes one generated adapter package so no stale generated file can
/// survive into the fresh build. The destructive operation is guarded at the
/// call site: symlinks may not move the source/generated/package roots outside
/// their owning project directories.
async fn clear_generated_package(
  project : @cli.Project,
  pkg_dir : String,
) -> Unit {
  let source_path = @cli.source_root(project)
  let source_root = @fs.realpath(source_path) catch {
    _ =>
      @cli.fail_cli("cannot resolve the module source root at \{source_path}")
  }
  guard path_is_within(project.root, source_root) else {
    @cli.fail_cli(
      "refusing to clear generated entries: module source root resolves outside the project",
    )
  }
  let generated_path = @cli.under_root(source_path, @cli.GENERATED_ENTRY_DIR)
  if @fs.exists(generated_path) {
    let generated_root = @fs.realpath(generated_path) catch {
      _ =>
        @cli.fail_cli(
          "cannot resolve the generated entry root at \{generated_path}",
        )
    }
    guard generated_root != source_root &&
      path_is_within(source_root, generated_root) else {
      @cli.fail_cli(
        "refusing to clear generated entries outside the module source root",
      )
    }
    if @fs.exists(pkg_dir) {
      let resolved_pkg = @fs.realpath(pkg_dir) catch {
        _ => @cli.fail_cli("cannot resolve the generated entry at \{pkg_dir}")
      }
      guard resolved_pkg != generated_root &&
        path_is_within(generated_root, resolved_pkg) else {
        @cli.fail_cli(
          "refusing to clear generated entry outside \{generated_path}",
        )
      }
      remove_owned_tree(generated_root, pkg_dir, "generated entry")
    }
  } else if @fs.exists(pkg_dir) {
    @cli.fail_cli(
      "refusing to clear generated entry without its owned generated root",
    )
  }
}

///|
async fn write_generated_file(path : String, text : String) -> Unit {
  @fs.write_file(path, @utf8.encode(text)) catch {
    _ => @cli.fail_cli("cannot write generated file \{path}")
  }
}

///|
/// Regenerates the Web Host entry (wasm executable, ABI v0 exports) and
/// returns its filesystem package path for `moon build`.
async fn generate_web_entry(project : @cli.Project) -> String {
  let pkg_dir = @cli.generated_web_entry_dir(project)
  clear_generated_package(project, pkg_dir)
  ensure_dir(pkg_dir)
  let app_import = @cli.application_package_import(project)
  let moon_pkg : String =
    $|import {
    $|  "\{app_import}" @passport_app,
    $|  "colmugx/ai-passport/hostabi",
    $|  "colmugx/ai-passport/runtime",
    $|}
    $|
    $|supported_targets = "wasm"
    $|
    $|pkgtype(kind: "executable")
    $|
    $|options(
    $|  link: {
    $|    "wasm": {
    $|      "exports": [
    $|        "passport_frame",
    $|        "passport_input",
    $|        "passport_fb_ptr",
    $|        "passport_fb_len",
    $|        "passport_frame_dirty",
    $|        "passport_frame_consume",
    $|      ],
    $|      "heap-start-address": 65536,
    $|    },
    $|  },
    $|)
    $|
  write_generated_file("\{pkg_dir}/moon.pkg", moon_pkg)
  let adapter : String =
    #|///|
    #|/// Generated by the passport CLI; regenerated by every build. Do not edit.
    #|
    #|///|
    #|let state : @runtime.WebRuntime = @runtime.WebRuntime::new_wasm(
    #|  @passport_app.passport_main(),
    #|)
    #|
    #|///|
    #|fn main {
    #|  state.start()
    #|}
    #|
    #|///|
    #|pub fn passport_frame(now_us : Int64) -> Unit {
    #|  state.frame(now_us)
    #|}
    #|
    #|///|
    #|pub fn passport_input(button : Int, pressed : Int) -> Unit {
    #|  state.input(button, pressed)
    #|}
    #|
    #|///|
    #|pub fn passport_fb_ptr() -> Int {
    #|  @hostabi.FRAMEBUFFER_PTR
    #|}
    #|
    #|///|
    #|pub fn passport_fb_len() -> Int {
    #|  @hostabi.FRAMEBUFFER_LEN
    #|}
    #|
    #|///|
    #|pub fn passport_frame_dirty() -> Int {
    #|  state.frame_dirty()
    #|}
    #|
    #|///|
    #|pub fn passport_frame_consume() -> Unit {
    #|  state.frame_consume()
    #|}
    #|
  write_generated_file("\{pkg_dir}/adapter.mbt", adapter)
  println(
    "passport: generated the Web entry adapter at \{pkg_dir} for application entry \"\{project.contract.entry}\"",
  )
  pkg_dir
}

///|
/// Regenerates the FoloToy Host native entry (foreign library, the eight
/// `ai_passport_mbt_*` C symbols) and returns its filesystem package path
/// for `moon build`. `cc_path` wires the capture cc into the link options
/// for the capture invocation — a machine-specific path the CLI rewrites
/// away afterwards (pass `None` for the plain package), because the package
/// is CLI-owned: nothing to inject or restore.
async fn generate_device_entry(
  project : @cli.Project,
  cc_path : String?,
) -> String {
  let pkg_dir = @cli.generated_device_entry_dir(project)
  clear_generated_package(project, pkg_dir)
  ensure_dir(pkg_dir)
  let app_import = @cli.application_package_import(project)
  let link_options : String = match cc_path {
    Some(cc) =>
      (
        $|options(
        $|  link: {
        $|    "native": {
        $|      "cc": "\{cc}",
        $|    },
        $|  },
        $|)
        $|
      )
    None => ""
  }
  let moon_pkg : String =
    $|import {
    $|  "\{app_import}" @passport_app,
    $|  "colmugx/ai-passport/runtime",
    $|}
    $|
    $|supported_targets = "native"
    $|
    $|pkgtype(kind: "foreign_library")
    $|
    $|\{link_options}
  write_generated_file("\{pkg_dir}/moon.pkg", moon_pkg)
  let adapter : String =
    #|///|
    #|/// Generated by the passport CLI; regenerated by every build. Do not edit.
    #|/// Every ai_passport_mbt_* export has C type int32_t(...), including
    #|/// the Unit-returning ones (the C app_main declares them so).
    #|
    #|///|
    #|#export_name("ai_passport_mbt_probe")
    #|pub fn probe() -> Int {
    #|  @runtime.DEVICE_PROBE
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_app_init")
    #|pub fn app_init() -> Unit {
    #|  @runtime.device_boot(@passport_app.passport_main)
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_app_update")
    #|pub fn app_update() -> Unit {
    #|  @runtime.device_update()
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_app_draw")
    #|pub fn app_draw() -> Unit {
    #|  @runtime.device_draw()
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_app_present")
    #|pub fn app_present() -> Unit {
    #|  @runtime.device_present()
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_input_event")
    #|pub fn input_event(button : Int, kind : Int) -> Unit {
    #|  @runtime.device_input_event(button, kind)
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_audio_volume")
    #|pub fn audio_volume() -> Int {
    #|  @runtime.device_audio_volume()
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_audio_muted")
    #|pub fn audio_muted() -> Int {
    #|  @runtime.device_audio_muted()
    #|}
    #|
  write_generated_file("\{pkg_dir}/adapter.mbt", adapter)
  println(
    "passport: generated the FoloToy entry adapter at \{pkg_dir} for application entry \"\{project.contract.entry}\"",
  )
  pkg_dir
}
