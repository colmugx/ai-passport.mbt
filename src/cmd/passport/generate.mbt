///|
/// Generation of the Host entry adapter packages under
/// `<project>/passport-generated/`. They are generated build output,
/// recreated wholesale by every build: each adapter imports the project's
/// application entry, wraps it in the SDK runtime for one Host, and exposes
/// exactly that Host's ABI. The project's own source tree is never written.

///|
/// The single-entry contract requires the module source root to be the
/// project root: moon must discover the generated entry packages as part of
/// the project module, and it only discovers packages under the source
/// root.
fn require_root_source(project : @cli.Project) -> Unit raise {
  guard project.source_dir == "" else {
    @cli.fail_cli(
      "the application entry contract requires the module source root to be the project root; remove `source = \"\{project.source_dir}\"` from moon.mod (generated Host entries are discovered as project packages)",
    )
  }
}

///|
async fn write_generated_file(path : String, text : String) -> Unit {
  @fs.write_file(path, @utf8.encode(text)) catch {
    _ => @cli.fail_cli("cannot write generated file \{path}")
  }
}

///|
/// Regenerates the Web Host entry (wasm executable, ABI v0 exports) and
/// returns its package path for `moon build`.
async fn generate_web_entry(project : @cli.Project) -> String {
  require_root_source(project)
  let pkg_dir = @cli.under_root(project.root, @cli.generated_web_entry())
  ensure_dir(pkg_dir)
  let app_import = @cli.application_package_import(project)
  let moon_pkg : String =
    $|import {
    $|  "\{app_import}" @passport_app,
    $|  "colmugx/ai-passport/hostabi",
    $|  "colmugx/ai-passport/runtime",
    $|}
    $|
    $|supported_targets = "wasm"
    $|
    $|pkgtype(kind: "executable")
    $|
    $|options(
    $|  link: {
    $|    "wasm": {
    $|      "exports": [
    $|        "passport_frame",
    $|        "passport_input",
    $|        "passport_fb_ptr",
    $|        "passport_fb_len",
    $|        "passport_frame_dirty",
    $|        "passport_frame_consume",
    $|      ],
    $|      "heap-start-address": 65536,
    $|    },
    $|  },
    $|)
    $|
  write_generated_file("\{pkg_dir}/moon.pkg", moon_pkg)
  let adapter : String =
    #|///|
    #|/// Generated by the passport CLI: the Web Host entry adapter for this
    #|/// application. Regenerated by every build; never edited.
    #|
    #|///|
    #|let state : @runtime.WebRuntime = @runtime.WebRuntime::new_wasm(
    #|  @passport_app.passport_main(),
    #|)
    #|
    #|///|
    #|fn main {
    #|  state.start()
    #|}
    #|
    #|///|
    #|pub fn passport_frame(now_us : Int64) -> Unit {
    #|  state.frame(now_us)
    #|}
    #|
    #|///|
    #|pub fn passport_input(button : Int, pressed : Int) -> Unit {
    #|  state.input(button, pressed)
    #|}
    #|
    #|///|
    #|pub fn passport_fb_ptr() -> Int {
    #|  @hostabi.FRAMEBUFFER_PTR
    #|}
    #|
    #|///|
    #|pub fn passport_fb_len() -> Int {
    #|  @hostabi.FRAMEBUFFER_LEN
    #|}
    #|
    #|///|
    #|pub fn passport_frame_dirty() -> Int {
    #|  state.frame_dirty()
    #|}
    #|
    #|///|
    #|pub fn passport_frame_consume() -> Unit {
    #|  state.frame_consume()
    #|}
    #|
  write_generated_file("\{pkg_dir}/adapter.mbt", adapter)
  println(
    "passport: generated the Web entry adapter at \{pkg_dir} for application entry \"\{project.contract.entry}\"",
  )
  @cli.generated_web_entry()
}

///|
/// Regenerates the FoloToy Host native entry (foreign library, the eight
/// `ai_passport_mbt_*` C symbols) and returns its package path for
/// `moon build`. `cc_path` wires the capture cc into the link options for
/// the capture invocation — a machine-specific path the CLI rewrites away
/// afterwards (pass `None` for the plain package), because the package is
/// CLI-owned: nothing to inject or restore.
async fn generate_device_entry(
  project : @cli.Project,
  cc_path : String?,
) -> String {
  require_root_source(project)
  let pkg_dir = @cli.under_root(project.root, @cli.generated_device_entry())
  ensure_dir(pkg_dir)
  let app_import = @cli.application_package_import(project)
  let link_options : String = match cc_path {
    Some(cc) =>
      (
        $|options(
        $|  link: {
        $|    "native": {
        $|      "cc": "\{cc}",
        $|    },
        $|  },
        $|)
        $|
      )
    None => ""
  }
  let moon_pkg : String =
    $|import {
    $|  "\{app_import}" @passport_app,
    $|  "colmugx/ai-passport/runtime",
    $|}
    $|
    $|supported_targets = "native"
    $|
    $|pkgtype(kind: "foreign_library")
    $|
    $|\{link_options}
  write_generated_file("\{pkg_dir}/moon.pkg", moon_pkg)
  let adapter : String =
    #|///|
    #|/// Generated by the passport CLI: the FoloToy Host native entry adapter
    #|/// for this application. Regenerated by every build; never edited.
    #|/// Every ai_passport_mbt_* export has C type
    #|/// int32_t(...), including the Unit-returning ones (the C app_main
    #|/// declares them so).
    #|
    #|///|
    #|#export_name("ai_passport_mbt_probe")
    #|pub fn probe() -> Int {
    #|  @runtime.DEVICE_PROBE
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_app_init")
    #|pub fn app_init() -> Unit {
    #|  @runtime.device_boot(@passport_app.passport_main)
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_app_update")
    #|pub fn app_update() -> Unit {
    #|  @runtime.device_update()
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_app_draw")
    #|pub fn app_draw() -> Unit {
    #|  @runtime.device_draw()
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_app_present")
    #|pub fn app_present() -> Unit {
    #|  @runtime.device_present()
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_input_press")
    #|pub fn input_press(code : Int) -> Unit {
    #|  @runtime.device_input(code)
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_audio_volume")
    #|pub fn audio_volume() -> Int {
    #|  @runtime.device_audio_volume()
    #|}
    #|
    #|///|
    #|#export_name("ai_passport_mbt_audio_muted")
    #|pub fn audio_muted() -> Int {
    #|  @runtime.device_audio_muted()
    #|}
    #|
  write_generated_file("\{pkg_dir}/adapter.mbt", adapter)
  println(
    "passport: generated the FoloToy entry adapter at \{pkg_dir} for application entry \"\{project.contract.entry}\"",
  )
  @cli.generated_device_entry()
}
