///|
test "sound mapping renders typed declaration-order constructors" {
  let metadata = @cli.compile_sound_metadata([
    { name: "ambient_walk", source: "assets/ambient.pcm", },
    { name: "jump", source: "assets/jump.pcm", },
  ])
  inspect(
    @cli.render_sound_mapping(metadata),
    content=(
      #|/// Generated by passport from passport.toml. Do not edit.
      #|
      #|///|
      #|pub(all) enum Sound {
      #|  AmbientWalk
      #|  Jump
      #|} derive(Eq, Debug)
      #|
      #|///|
      #|pub impl @audio.Sound for Sound with fn resource_id(self : Sound) -> UInt {
      #|  match self {
      #|    AmbientWalk => 0U
      #|    Jump => 1U
      #|  }
      #|}
      #|
    ),
  )
}

///|
test "sound mapping supports a project with no sounds" {
  inspect(
    @cli.render_sound_mapping(@cli.compile_sound_metadata([])),
    content=(
      #|/// Generated by passport from passport.toml. Do not edit.
      #|
      #|///|
      #|pub(all) enum Sound {
      #|} derive(Eq, Debug)
      #|
      #|///|
      #|pub impl @audio.Sound for Sound with fn resource_id(self : Sound) -> UInt {
      #|  match self {
      #|  }
      #|}
      #|
    ),
  )
}

///|
test "renaming and deleting sounds removes stale constructors" {
  let before = @cli.render_sound_mapping(
    @cli.compile_sound_metadata([
      { name: "ambient_walk", source: "assets/ambient.pcm", },
      { name: "jump", source: "assets/jump.pcm", },
    ]),
  )
  let after = @cli.render_sound_mapping(
    @cli.compile_sound_metadata([
      { name: "ambient_path", source: "assets/ambient.pcm", },
    ]),
  )
  inspect(before.contains("AmbientWalk"), content="true")
  inspect(before.contains("Jump"), content="true")
  inspect(after.contains("AmbientPath"), content="true")
  inspect(after.contains("AmbientWalk"), content="false")
  inspect(after.contains("Jump"), content="false")
}
