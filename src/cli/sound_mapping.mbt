///|
/// Renders the application-owned `@sounds` package from compiled metadata.
/// An enum is used because MoonBit uppercase identifiers are constructors,
/// giving applications values such as `@sounds.Jump` without numeric IDs.
pub fn render_sound_mapping(sounds : Array[SoundMetadata]) -> String {
  let out = StringBuilder()
  out.write_string(
    "/// Generated by passport from passport.toml. Do not edit.\n\n",
  )
  out.write_string("///|\npub(all) enum Sound {\n")
  sounds.each(fn(sound) { out.write_string("  \{sound.symbol}\n") })
  out.write_string("} derive(Eq, Debug)\n\n")
  out.write_string(
    "///|\npub impl @audio.Sound for Sound with fn resource_id(self : Sound) -> UInt {\n",
  )
  out.write_string("  match self {\n")
  sounds.each(fn(sound) {
    out.write_string("    \{sound.symbol} => \{sound.id}U\n")
  })
  out.write_string("  }\n}\n")
  out.to_string()
}
