import {
  "colmugx/ai-passport/application",
  "colmugx/ai-passport/audio",
  "colmugx/ai-passport/graphics",
  "colmugx/ai-passport/hostabi",
  "colmugx/ai-passport/runtime",
}

supported_targets = "wasm"

pkgtype(kind: "executable")

options(
  link: {
    "wasm": {
      "exports": [
        "passport_frame",
        "passport_input",
        "passport_fb_ptr",
        "passport_fb_len",
        "passport_frame_dirty",
        "passport_frame_consume",
      ],
      "heap-start-address": 262144,
    },
  },
)
